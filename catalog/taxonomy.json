{
  "canonical_id": {
    "immutable": true,
    "pattern": "^[a-z0-9]+(?:[.:-][a-z0-9]+)*$"
  },
  "facets": {
    "domain": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["business", "daily-life", "data", "design", "documents", "education", "life", "media", "operations", "research", "science", "software"]
    },
    "inputs": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["api", "audio", "clothing", "code", "document", "file", "food", "household-context", "image", "release", "report", "repository", "shopping-needs", "spreadsheet", "webpage"]
    },
    "intent": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["analyze", "create", "diagnose", "discover", "maintain", "operate", "publish", "research", "transform", "validate"]
    },
    "maturity": {
      "cardinality": "exactly-one",
      "extensible": false,
      "values": ["candidate", "deprecated", "published", "signal", "verified"]
    },
    "outputs": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["code", "decision", "evidence", "file", "instructions", "plan", "release", "report"]
    },
    "platforms": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["ansible", "cargo", "codex", "curl", "docker", "fresh-market", "git", "github", "github-actions", "grocery-store", "home-kitchen", "http", "laundry-area", "linux", "macos", "nodejs", "npm", "playwright", "pytest", "rust", "web", "windows"]
    },
    "risk": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["allergen", "credentials", "financial", "food-safety", "high-risk", "legal", "medical", "physical-safety", "standard"]
    },
    "side_effects": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["external-publish", "household-consumption", "human-physical-action", "local-write", "network-read", "network-write", "read-only"]
    },
    "tools": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["ansible-test", "cargo", "codex", "curl", "docker", "gh", "git", "household-appliance", "kitchen-tools", "npm", "playwright", "pytest", "python"]
    },
    "trust": {
      "cardinality": "one-or-more",
      "extensible": true,
      "values": ["community", "discovery", "official", "primary"]
    },
    "volatility": {
      "cardinality": "exactly-one",
      "extensible": false,
      "values": ["fast-moving", "periodic", "stable"]
    }
  },
  "primary_family": {
    "cardinality": "exactly-one",
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  },
  "schema_version": 1,
  "taxonomy_version": "1.2.0"
}
